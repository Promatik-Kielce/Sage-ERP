<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="custom_hr_org_chart.hr_org_chart_employee">
    <t t-set="is_self" t-value="employee.id == employeeId"/>

    <section t-if="employee_type == 'self'" t-attf-class="o_org_chart_entry_self_container #{state.managers.length &gt; 0 ? 'o_org_chart_has_managers' : ''}">
        <div t-attf-class="o_org_chart_entry o_org_chart_entry_#{employee_type} position-relative d-flex align-items-center overflow-visible #{state.managers.length &gt; 0 ? 'o_treeEntry' : ''}">
            <t t-call="custom_hr_org_chart.hr_org_chart_employee_content">
                <t t-set="is_self" t-value="is_self"/>
                <t t-set="employee_type_local" t-value="employee_type"/>
            </t>
        </div>
    </section>

    <div t-else="" t-attf-class="o_org_chart_entry o_org_chart_entry_#{employee_type} o_treeEntry position-relative d-flex align-items-center overflow-visible">
        <t t-call="custom_hr_org_chart.hr_org_chart_employee_content">
            <t t-set="is_self" t-value="is_self"/>
            <t t-set="employee_type_local" t-value="employee_type"/>
        </t>
    </div>
</t>

<t t-name="custom_hr_org_chart.hr_org_chart_employee_informations">
    <div class="o_media_left align-self-start rounded z-1">
        <div
            class="o_media_object img-fluid d-block rounded"
            t-att-style="'background-image:url(\'/web/image/hr.employee.public/' + employee.id + '/avatar_1024/\')'"
            t-att-alt="employee.name"
        />
    </div>
    <div class="position-relative d-flex flex-column flex-grow-1 justify-content-center ps-2 lh-sm">
        <b class="o_media_heading fs-6 fw-bold" t-esc="employee.name"/>
        <small class="o_employee_job text-muted" t-attf-class="#{is_self ? 'fw-bold' : 'opacity-75 opacity-100-hover'}" t-esc="employee.job_name"/>
    </div>
</t>

<t t-name="custom_hr_org_chart.hr_org_chart_employee_content">
    <a t-if="!is_self" t-att-href="employee.link" class="o_employee_redirect d-flex w-100 me-auto opacity-trigger-hover" t-att-data-employee-id="employee.id" t-on-click.prevent="() => this._onEmployeeRedirect(employee.id)">
        <t t-call="custom_hr_org_chart.hr_org_chart_employee_informations">
            <t t-set="is_self" t-value="is_self"/>
        </t>
    </a>
    <div t-if="is_self" class="d-flex w-100 me-auto">
        <t t-call="custom_hr_org_chart.hr_org_chart_employee_informations">
            <t t-set="is_self" t-value="is_self"/>
        </t>
    </div>

    <!-- badge z liczbą podwładnych pokazujemy tylko dla self i subordinates, nie dla managerów -->
    <button t-if="employee.indirect_sub_count &gt; 0 and employee_type_local != 'manager'"
            class="btn btn-secondary btn-sm d-flex ms-2 rounded-pill"
            tabindex="0"
            t-att-data-emp-name="employee.name"
            t-att-data-emp-id="employee.id"
            t-att-data-emp-dir-subs="employee.direct_sub_count"
            t-att-data-emp-ind-subs="employee.indirect_sub_count"
            t-on-click="(event) => this._onOpenPopover(event, employee)">
        <span class="badge px-0" t-esc="employee.indirect_sub_count"/>
    </button>
</t>

<t t-name="custom_hr_org_chart.hr_org_chart">
    <t t-set="emp_count" t-value="0"/>

    <div t-if="state.managers.length &gt; 0" class="o_org_chart_group_up position-relative">
        <div t-if="state.managers_more" class="o_org_chart_more pe-3">
            <a href="#" t-att-data-employee-id="state.managers[0].id" class="o_employee_more_managers d-block bg-100 px-2" t-on-click.prevent="() => this._onEmployeeMoreManager(state.managers[0].id)">
                <i class="fa fa-angle-double-up" role="img" aria-label="More managers" title="More managers"/>
            </a>
        </div>

        <t t-foreach="state.managers" t-as="employee" t-key="employee.id">
            <t t-set="emp_count" t-value="emp_count + 1"/>
            <t t-call="custom_hr_org_chart.hr_org_chart_employee">
                <t t-set="employee_type" t-value="'manager'"/>
            </t>
        </t>
    </div>

    <t t-if="state.children.length || state.managers.length" t-call="custom_hr_org_chart.hr_org_chart_employee">
        <t t-set="employee_type" t-value="'self'"/>
        <t t-set="employee" t-value="state.self"/>
    </t>

    <t t-if="!state.children.length &amp;&amp; !state.managers.length">
        <p class="mb-3 text-muted fst-italic">Set a manager or reports to show in org chart.</p>
    </t>

    <div t-if="state.children.length" t-attf-class="o_org_chart_group_down position-relative #{state.managers.length &gt; 0 ? 'o_org_chart_has_managers' : ''}">
        <t t-foreach="state.children" t-as="employee" t-key="employee.id">
            <t t-set="emp_count" t-value="emp_count + 1"/>
            <t t-if="emp_count &lt; 20">
                <t t-call="custom_hr_org_chart.hr_org_chart_employee">
                    <t t-set="employee_type" t-value="'sub'"/>
                </t>
            </t>
        </t>

        <t t-if="(state.children.length + state.managers.length) &gt; 19">
            <div class="o_org_chart_entry o_org_chart_more d-flex overflow-visible">
                <div class="o_media_left position-relative">
                    <a href="#"
                        t-att-data-employee-id="state.self.id"
                        t-att-data-employee-name="state.self.name"
                        class="o_org_chart_show_more o_employee_sub_redirect btn btn-link ps-2"
                        t-on-click.prevent="_onEmployeeSubRedirect">See All</a>
                </div>
            </div>
        </t>
    </div>
</t>

</templates>