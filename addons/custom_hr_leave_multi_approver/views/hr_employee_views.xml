<odoo>
    <record id="view_employee_form_multi_leave_approver_inherit" model="ir.ui.view">
        <field name="name">hr.employee.form.multi.leave.approver.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page string="Time Off Approvers">
                    <group col="2">
                        <group string="Summary">
                            <field name="leave_manager_id" string="Primary Time Off Approver" readonly="1"/>
                            <field name="leave_manager_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                        <group string="Info">
                            <div class="o_form_label">Use the list below to assign many time off approvers.</div>
                            <div class="o_form_label">Mark exactly one row as Primary Approver.</div>
                            <div class="o_form_label">Changing the primary row updates the main leave approver automatically.</div>
                        </group>
                    </group>

                    <separator string="Approver Relations"/>

                    <field name="leave_approver_relation_ids" context="{'default_employee_id': id}" nolabel="1">
                        <list editable="bottom" create="1" delete="1">
                            <field name="sequence" widget="handle"/>
                            <field name="user_id"/>
                            <field name="is_primary"/>
                            <field name="active"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>
</odoo>