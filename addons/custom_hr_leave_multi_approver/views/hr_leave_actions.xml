<odoo>
    <record id="action_my_team_time_off_multi_approver" model="ir.actions.act_window">
        <field name="name">My Team Time Off</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">list,form,calendar,pivot</field>
        <field name="domain">
            [
                '|',
                ('employee_id.leave_manager_id', '=', uid),
                ('employee_id.leave_manager_ids', 'in', [uid])
            ]
        </field>
    </record>

    <menuitem
        id="menu_my_team_time_off_multi_approver"
        name="My Team Time Off"
        parent="hr_holidays.menu_hr_holidays_root"
        action="action_my_team_time_off_multi_approver"
        groups="custom_hr_leave_multi_approver.group_timeoff_multi_approver"
        sequence="25"
    />
</odoo>