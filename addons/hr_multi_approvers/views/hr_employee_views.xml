<odoo>
    <record id="view_employee_form_multi_manager_inherit" model="ir.ui.view">
        <field name="name">hr.employee.form.multi.manager.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='parent_id']" position="attributes">
                <attribute name="string">Primary Manager</attribute>
            </xpath>

            <xpath expr="//field[@name='parent_id']" position="after">
                <separator string="Manager Structure"/>
                <field name="manager_relation_ids" context="{'default_employee_id': id}">
                    <list editable="bottom">
                        <field name="sequence" widget="handle"/>
                        <field name="manager_id"/>
                        <field name="is_primary"/>
                        <field name="active"/>
                    </list>
                </field>
            </xpath>

        </field>
    </record>
</odoo>