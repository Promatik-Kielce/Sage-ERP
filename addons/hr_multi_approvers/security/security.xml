<odoo>
    <record id="group_hr_multi_leave_approver_limited" model="res.groups">
        <field name="name">Limited Multi Leave Approver</field>
    </record>

    <record id="hr_leave_rule_multi_leave_approver_limited" model="ir.rule">
        <field name="name">Limited approver sees only assigned employee leaves</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="groups" eval="[(4, ref('hr_multi_approvers.group_hr_multi_leave_approver_limited'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
        <field name="domain_force">[
            ('employee_id.leave_approver_relation_ids.user_id', '=', user.id),
            ('employee_id.leave_approver_relation_ids.active', '=', True)
        ]</field>
    </record>
</odoo>