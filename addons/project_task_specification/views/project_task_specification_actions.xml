<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="action_project_task_specification" model="ir.actions.act_window">
    <field name="name">Specyfikacja Projektowa</field>
    <field name="res_model">project.task.specification</field>
    <field name="view_mode">kanban,list,form</field>

    <!-- KLUCZ: filtruj po projekcie przekazanym w kontekście -->
    <field name="domain">[('project_id', '=', context.get('default_project_id'))]</field>

    <!-- KLUCZ: ustaw default_project_id (JS i tak go podaje) -->
    <field name="context">{'default_project_id': context.get('default_project_id')}</field>

    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Dodaj pierwszy kafelek specyfikacji projektu.
      </p>
      <p>
        Możesz tutaj przechowywać założenia, zakres, ograniczenia i kryteria akceptacji.
      </p>
    </field>
  </record>

</odoo>