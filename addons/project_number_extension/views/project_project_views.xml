<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View - Add project_number field in title section before name -->
    <record id="project_project_form_view_inherit_number" model="ir.ui.view">
        <field name="name">project.project.form.inherit.number</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="project_number"
                       placeholder="np. PRJ-001"
                       class="oe_inline"
                       style="width: 200px; margin-right: 10px;"/>
            </xpath>
            <xpath expr="//group/group/field[@name='label_tasks']" position="before">
                <field name="project_number"
                       string="Numer Projektu"
                       placeholder="np. PRJ-001"
                       required="1"/>
            </xpath>
        </field>
    </record>

    <!-- Simplified Form View - Add project_number field -->
    <record id="project_project_form_view_simplified_inherit_number" model="ir.ui.view">
        <field name="name">project.project.form.simplified.inherit.number</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.project_project_view_form_simplified"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='name']" position="before">
                <label for="project_number" string="Numer Projektu"/>
                <h2>
                    <field name="project_number"
                           placeholder="np. PRJ-001"
                           required="1"
                           class="o_project_number"/>
                </h2>
            </xpath>
        </field>
    </record>

    <!-- Main list view -->
    <record id="project_project_list_view_inherit_number" model="ir.ui.view">
        <field name="name">project.project.list.inherit.number</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">is_favorite desc, project_number asc, sequence asc, name asc, id asc</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="project_number" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Main kanban view -->
    <record id="project_project_kanban_view_inherit_number_order" model="ir.ui.view">
        <field name="name">project.project.kanban.inherit.number.order</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="default_order">is_favorite desc, project_number asc, sequence asc, name asc, id asc</attribute>
            </xpath>
        </field>
    </record>

    <!-- Config list view -->
    <record id="project_project_config_list_view_inherit_number_order" model="ir.ui.view">
        <field name="name">project.project.config.list.inherit.number.order</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_config"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">is_favorite desc, project_number asc, sequence asc, name asc, id asc</attribute>
            </xpath>
        </field>
    </record>

    <!-- Template list view -->
    <record id="project_project_templates_list_view_inherit_number_order" model="ir.ui.view">
        <field name="name">project.project.templates.list.inherit.number.order</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.project_templates_view_list"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">is_favorite desc, project_number asc, sequence asc, name asc, id asc</attribute>
            </xpath>
        </field>
    </record>

    <!-- Search View -->
    <record id="project_project_search_view_inherit_number" model="ir.ui.view">
        <field name="name">project.project.search.inherit.number</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_project_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="project_number"
                       string="Project Number"
                       filter_domain="['|', ('project_number', 'ilike', self), ('name', 'ilike', self)]"/>
            </xpath>
        </field>
    </record>

</odoo>