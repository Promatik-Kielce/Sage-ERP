#. module: hr_attendance_employee_access
#: model:res.groups,comment:hr_attendance_employee_access.group_hr_attendance_all_reader
msgid ""
"This group allows employees to view all attendance records\n"
"across the entire organization in read-only mode.\n"
"Promotes workplace transparency."
msgstr ""
"Ta grupa pozwala pracownikom przeglądać wszystkie rekordy obecności\n"
"w całej organizacji w trybie tylko do odczytu.\n"
"Promuje przejrzystość w miejscu pracy."

#. module: hr_attendance_employee_access
#: model:ir.actions.act_window,help:hr_attendance_employee_access.hr_attendance_action_employee_all
msgid ""
"<p class=\"o_view_nocontent_smiling_face\">\n"
"                    No attendance records found\n"
"                </p>\n"
"                <p>\n"
"                    This view shows all employee attendance records across the organization.\n"
"                    You have read-only access to promote workplace transparency.\n"
"                </p>"
msgstr ""
"<p class=\"o_view_nocontent_smiling_face\">\n"
"                    Nie znaleziono rekordów obecności\n"
"                </p>\n"
"                <p>\n"
"                    Ten widok pokazuje wszystkie rekordy obecności pracowników w organizacji.\n"
"                    Masz dostęp tylko do odczytu, aby promować przejrzystość w miejscu pracy.\n"
"                </p>"

