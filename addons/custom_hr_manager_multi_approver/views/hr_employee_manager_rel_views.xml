<odoo>
    <record id="view_hr_employee_manager_rel_tree" model="ir.ui.view">
        <field name="name">hr.employee.manager.rel.tree</field>
        <field name="model">hr.employee.manager.rel</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="employee_id"/>
                <field name="manager_id"/>
                <field name="is_primary"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hr_employee_manager_rel_form" model="ir.ui.view">
        <field name="name">hr.employee.manager.rel.form</field>
        <field name="model">hr.employee.manager.rel</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="manager_id"/>
                        <field name="sequence"/>
                        <field name="is_primary"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_employee_manager_rel" model="ir.actions.act_window">
        <field name="name">Employee Manager Relations</field>
        <field name="res_model">hr.employee.manager.rel</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hr_employee_manager_rel"
              name="Manager Relations"
              parent="hr.menu_hr_root"
              action="action_hr_employee_manager_rel"
              groups="hr.group_hr_manager"/>
</odoo>