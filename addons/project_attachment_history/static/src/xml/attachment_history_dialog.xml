<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="project_attachment_history.AttachmentHistoryDialog">
        <Dialog size="size" title="props.title" contentClass="'h-100 html-history-dialog-container'"
                t-on-close="props.close" t-on-cancel="props.close">
            <div t-attf-class="dialog-container html-history-dialog o_attachment_history {{ state.loading ? 'html-history-loading' : 'html-history-loaded' }}">

                <div class="revision-list d-flex flex-column align-content-stretch"
                     t-attf-style="max-height: {{ state.cssMaxHeight }}px;">
                    <t t-if="!state.revisionsData.length">
                        <div class="text-center w-100 pb-2 pt-0 px-0 fw-bolder">No history</div>
                    </t>
                    <t t-foreach="state.revisionsData" t-as="rev" t-key="rev.revision_id">
                        <a href="#" role="button"
                           t-att-title="rev.summary"
                           t-att-class="this.getRevisionClasses(rev)"
                           t-on-click.prevent="() => this.updateCurrentRevision(rev.revision_id)">
                            <small><t t-esc="this.getRevisionDate(rev)"/></small>
                            <div class="o_attachment_history_summary text-truncate small text-muted"
                                 t-esc="rev.summary"/>
                            <div class="o_avatar">
                                <img class="rounded" t-att-src="this.getRevisionAuthorAvatar(rev)"
                                     t-att-alt="rev.create_user_name" t-att-title="rev.create_user_name"/>
                            </div>
                        </a>
                    </t>
                </div>

                <div class="history-container" t-attf-style="max-height: {{ state.cssMaxHeight }}px;">
                    <div class="history-view-top-bar">
                        <div>
                            <div class="text-info smaller">
                                <i class="fa fa-info-circle me-1" title="Version date"/>
                                <t t-esc="revisionCaption"/>
                            </div>
                        </div>
                        <div>
                            <span class="badge text-bg-secondary" t-esc="state.files.length"/>
                            file(s)
                        </div>
                    </div>

                    <div class="history-view-inner o_attachment_history_files"
                         t-attf-style="max-height: {{ state.cssMaxHeight - 60 }}px;">
                        <div t-if="state.loading" class="text-center text-muted p-4">
                            <i class="fa fa-circle-o-notch fa-spin fa-2x"/>
                        </div>
                        <div t-elif="!state.files.length" class="text-center text-muted fst-italic p-4">
                            There was no file on this record at that time.
                        </div>
                        <div t-else="" class="d-flex flex-wrap gap-3">
                            <t t-foreach="state.files" t-as="file" t-key="file.attachment_id">
                                <div t-attf-class="o_attachment_history_card card {{ file.changed_here ? 'border-primary' : '' }}">
                                    <div class="o_attachment_history_preview"
                                         t-on-click="() => this.onClickFile(file)"
                                         t-att-title="file.attachment.isViewable ? 'Preview' : 'Download'">
                                        <img t-if="file.attachment.has_thumbnail"
                                             class="o_attachment_history_thumbnail"
                                             t-att-src="file.attachment.thumbnailUrl" t-att-alt="file.name"/>
                                        <div t-else="" class="o_image" t-att-data-mimetype="file.attachment.mimetype"/>
                                    </div>
                                    <div class="card-body p-2">
                                        <div class="fw-bold text-truncate" t-att-title="file.name" t-esc="file.name"/>
                                        <div class="small text-muted" t-esc="this.formatSize(file)"/>
                                        <div t-if="file.changed_here" class="badge text-bg-primary mt-1"
                                             t-esc="this.changedLabel(file)"/>
                                        <div t-if="!file.present_now" class="badge text-bg-warning mt-1">
                                            not on the record any more
                                        </div>
                                        <div t-if="file.is_historical_content"
                                             class="badge text-bg-info mt-1" title="The content shown is the one this file had at the selected time.">
                                            content of that time
                                        </div>
                                        <div class="mt-2 d-flex gap-1">
                                            <button class="btn btn-sm btn-link p-0" title="Download"
                                                    t-on-click.stop="() => this.onClickDownload(file)">
                                                <i class="fa fa-download"/>
                                            </button>
                                            <button t-if="!file.present_now and file.restore_log_id"
                                                    class="btn btn-sm btn-link p-0" title="Restore this file"
                                                    t-on-click.stop="() => this.onClickRestoreFile(file)">
                                                <i class="fa fa-undo"/>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>

            <t t-set-slot="footer">
                <button class="btn btn-primary" t-att-disabled="!canRestoreSnapshot"
                        t-on-click="onClickRestoreSnapshot">
                    Restore this version
                </button>
                <button class="btn btn-secondary" t-on-click="props.close">Discard</button>
            </t>
        </Dialog>
    </t>

</templates>
