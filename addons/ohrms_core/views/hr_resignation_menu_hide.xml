<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Hide Resignation menus by restricting to no_one group -->
    <record id="hr_resignation.hr_resignation_menu_root" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_no_one')])]"/>
    </record>
    <record id="hr_resignation.hr_resignation_menu_request" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_no_one')])]"/>
    </record>
    <record id="hr_resignation.hr_resignation_menu_approved_request" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_no_one')])]"/>
    </record>
</odoo>
