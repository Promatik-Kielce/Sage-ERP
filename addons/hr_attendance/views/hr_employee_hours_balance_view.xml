<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Employee Hours Balance Line List View -->
    <record id="hr_employee_hours_balance_line_view_list" model="ir.ui.view">
        <field name="name">hr.employee.hours.balance.line.list</field>
        <field name="model">hr.employee.hours.balance.line</field>
        <field name="arch" type="xml">
            <list string="Hours Balance Detail" create="false" edit="false" delete="false" default_order="date desc" limit="0" decoration-primary="is_business_trip">
                <field name="date"/>
                <field name="is_business_trip" column_invisible="1"/>
                <field name="day_of_week"/>
                <field name="check_in_time"/>
                <field name="check_out_time"/>
                <field name="worked_hours" widget="float_time" sum="Total Worked"/>
                <field name="expected_hours" widget="float_time" sum="Total Expected"/>
                <field name="is_weekend" column_invisible="1"/>
                <field name="is_public_holiday" column_invisible="1"/>
                <field name="has_approved_leave" column_invisible="1"/>
                <field name="leave_name" optional="hide"/>
                <field name="output_balance"
                       class="text-center"
                       decoration-danger="output_balance_type == 'early'"
                       decoration-success="output_balance_type == 'late'"
                       decoration-bf="output_balance_type == 'early'"/>
                <field name="balance_delta" widget="float_time"
                       sum="Total +/-"
                       decoration-success="balance_delta &gt; 0"
                       decoration-danger="balance_delta &lt; 0"/>
                <field name="balance_cumulative" widget="float_time"
                       decoration-success="balance_cumulative &gt; 0"
                       decoration-danger="balance_cumulative &lt; 0"
                       decoration-bf="1"/>
                <field name="notes" optional="show"/>
                <field name="attendance_count" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Graph View 1: Daily Balance Delta (Bar Chart) - Default -->
    <record id="hr_employee_hours_balance_line_view_graph_daily" model="ir.ui.view">
        <field name="name">hr.employee.hours.balance.line.graph.daily</field>
        <field name="model">hr.employee.hours.balance.line</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <graph string="Daily Balance (+/-)" type="bar" stacked="False">
                <field name="date" interval="day"/>
                <field name="balance_delta" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Graph View 2: Cumulative Balance Trend (Line Chart) -->
    <record id="hr_employee_hours_balance_line_view_graph_cumulative" model="ir.ui.view">
        <field name="name">hr.employee.hours.balance.line.graph.cumulative</field>
        <field name="model">hr.employee.hours.balance.line</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <graph string="Balance Trend Over Time" type="line">
                <field name="date" interval="day"/>
                <field name="balance_cumulative" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Graph View 3: Worked vs Expected Hours (Grouped Bar Chart) -->
    <record id="hr_employee_hours_balance_line_view_graph_comparison" model="ir.ui.view">
        <field name="name">hr.employee.hours.balance.line.graph.comparison</field>
        <field name="model">hr.employee.hours.balance.line</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <graph string="Worked vs Expected Hours" type="bar">
                <field name="date" interval="day"/>
                <field name="worked_hours" type="measure"/>
                <field name="expected_hours" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Employee Hours Balance Line Pivot View (Keep for reference but not in detail action) -->
    <record id="hr_employee_hours_balance_line_view_pivot" model="ir.ui.view">
        <field name="name">hr.employee.hours.balance.line.pivot</field>
        <field name="model">hr.employee.hours.balance.line</field>
        <field name="arch" type="xml">
            <pivot string="Hours Balance Analysis">
                <field name="date" interval="week" type="row"/>
                <field name="worked_hours" type="measure"/>
                <field name="expected_hours" type="measure"/>
                <field name="balance_delta" type="measure"/>
            </pivot>
        </field>
    </record>

<!-- Employee Hours Balance Action -->
    <record id="hr_employee_hours_balance_line_action" model="ir.actions.act_window">
        <field name="name">Hours Balance Detail</field>
        <field name="res_model">hr.employee.hours.balance.line</field>
        <field name="view_mode">list,graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hours balance data available
            </p>
            <p>
                Hours balance shows the difference between worked and expected hours over time.
                <br/>
                Positive values indicate extra hours worked, negative values indicate hours owed.
            </p>
        </field>
    </record>

</odoo>
