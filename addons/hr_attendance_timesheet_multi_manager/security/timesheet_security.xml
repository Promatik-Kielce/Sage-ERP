<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Same domain as custom_hr_attendance_multi_manager.hr_attendance_rule_multi_manager,
         applied to the timesheets linked to those attendances. Who may change them is
         decided by account.analytic.line._check_access() in hr_attendance_timesheet_project. -->
    <record id="timesheet_rule_multi_manager" model="ir.rule">
        <field name="name">Attendance Officer: timesheets of the attendances of employees managed as secondary manager</field>
        <field name="model_id" ref="analytic.model_account_analytic_line"/>
        <field name="domain_force">[('attendance_id.employee_id.manager_relation_ids', 'any', [('active', '=', True), ('manager_id.user_id', '=', user.id)])]</field>
        <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_officer'))]"/>
    </record>
</odoo>
