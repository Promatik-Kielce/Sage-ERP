<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_knowledge" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.knowledge</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="document_knowledge.view_knowledge_configuration"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='attachment_user']" position="after">
                <setting id="knowledge_user"
                         string="Knowledge Articles"
                         help="Enable Knowledge articles for all internal users.">
                    <field name="group_knowledge_user"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
