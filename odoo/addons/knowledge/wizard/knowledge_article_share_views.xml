<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="knowledge_article_share_view_form" model="ir.ui.view">
        <field name="name">knowledge.article.share.form</field>
        <field name="model">knowledge.article.share</field>
        <field name="arch" type="xml">
            <form string="Share Article">
                <group>
                    <field name="article_id" readonly="1"/>
                    <field name="partner_ids" widget="many2many_tags"/>
                    <field name="permission"/>
                    <field name="send_notification"/>
                </group>
                <footer>
                    <button string="Share" name="action_share" type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="knowledge_article_share_action" model="ir.actions.act_window">
        <field name="name">Share Article</field>
        <field name="res_model">knowledge.article.share</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_knowledge_article"/>
        <field name="binding_view_types">form</field>
    </record>

</odoo>
